# Server-only Gemini credential. Never expose this in client code.
GEMINI_API_KEY=

# Optional Hugging Face API key / User Access Token (for Qwen 2.5 Coder, DeepSeek-R1, Llama 3.3, Flux.1)
HUGGINGFACE_API_KEY=
HF_TOKEN=

# Independent OpenRouter provider (server-only). This can power chat and agent runs
# without a Gemini key. Create a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Strong default model; change independently of the Gemini model.
ADAM_OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional comma-separated model-level fallbacks, for example: google/gemini-3.8-flash
ADAM_OPENROUTER_FALLBACK_MODELS=
# Optional attribution header for OpenRouter.
OPENROUTER_HTTP_REFERER=https://adam-ai-agent.vercel.app

# Optional stable Gemini model override. Gemini remains the fallback provider.
ADAM_GEMINI_MODEL=gemini-3.8-flash

# Optional HTTP port for the Node server.
PORT=3000

# Public URL used by a deployed web/mobile build when the API is hosted separately.
# Example: https://api.example.com
VITE_ADAM_API_URL=

# Google Maps Platform API Key (or use the free Maps Demo Key for prototyping)
VITE_GOOGLE_MAPS_API_KEY=

# Optional Monetization & Google AdSense Publisher credentials
VITE_ADSENSE_PUB_ID=
VITE_ADSENSE_SLOT_ID=
VITE_DONATION_URL=
