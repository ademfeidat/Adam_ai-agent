# Server-only Gemini credential. Never expose this in client code.
GEMINI_API_KEY=

# Optional Hugging Face API key / User Access Token (for Qwen 2.5 Coder, DeepSeek-R1, Llama 3.3, Flux.1)
HUGGINGFACE_API_KEY=
HF_TOKEN=

# Optional stable Gemini model override.
ADAM_GEMINI_MODEL=gemini-3.8-flash

# Optional HTTP port for the Node server.
PORT=3000

# Public URL used by a deployed web/mobile build when the API is hosted separately.
# Example: https://api.example.com
VITE_ADAM_API_URL=

# Google Maps Platform API Key (or use the free Maps Demo Key for prototyping)
VITE_GOOGLE_MAPS_API_KEY=

# Optional Monetization & Google AdSense Publisher credentials
VITE_ADSENSE_PUB_ID=
VITE_ADSENSE_SLOT_ID=
VITE_DONATION_URL=
