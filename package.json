{
  "name": "adam-ai-agent",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.js",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux",
    "cap:sync": "CAPACITOR_BUILD=true npm run build && npx cap sync android",
    "cap:android": "CAPACITOR_BUILD=true npm run build && npx cap sync android",
    "build:apk": "CAPACITOR_BUILD=true npm run build && npx cap sync android && cd android && chmod +x gradlew && ./gradlew assembleRelease --no-daemon",
    "build:apk:debug": "CAPACITOR_BUILD=true npm run build && npx cap sync android && cd android && chmod +x gradlew && ./gradlew assembleDebug --no-daemon",
    "open:android": "npx cap open android",
    "test:ci": "node --import tsx --test tests/chat-errors.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.4.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.17.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
